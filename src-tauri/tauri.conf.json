{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "usagi",
  "version": "0.2.0",
  "identifier": "net.orelav.usagi",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": { "script": "node scripts/gen-modules.js", "wait": true },
    "beforeBuildCommand": "node scripts/gen-modules.js"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "usagi",
        "width": 760,
        "height": 580,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "focus": false,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A desktop companion that lives in the top edge of your screen.",
    "copyright": "Copyright (c) 2026 Valentino Valero. All rights reserved.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
